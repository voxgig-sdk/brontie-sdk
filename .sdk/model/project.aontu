# Project overlay — YOURS. The scaffold creates this file once and never
# overwrites it.
#
# Most of model/ is toolchain-derived and is deliberately regenerated so that
# toolchain fixes propagate; this file, the guide, and the target, feature and
# edition indexes are kept. Put anything here that is a decision about THIS
# project rather than a fact about the API.
#
# Included LAST by sdk.aontu, after target/target-index.aontu, because a key
# under main.kit.target.<t> can only refine a target that has already been
# defined. Declared earlier, the model build fails with "Cannot unify value:
# nil with value: string / key ext value was: nil", which names nothing that
# would lead you here.
#
# The release version each generated manifest declares (package.json,
# pyproject.toml, the gemspec, the rockspec) and that the port Makefiles tag:
#
#   main: kit: target: ts: publish: version: '1.2.3'
#
# Per target, because ports publish to different registries on different
# clocks. Set every target to the same value for a lockstep repo.
#
# A published package name that does not follow the derivation:
#
#   main: kit: target: ts: publish: registry: package: '@scope/name'

# GitHub Pages is enabled for this repository, so generated documentation may
# link the site. Without this the README advertises no address, which is what
# an unpublished repository should do.
main: kit: doc: edition: 'github-pages': published: true

# Brand palette, taken from brontie.ie's own stylesheet and ranked by use
# there: #6ca3a4 sage (66 occurrences), #f4c24d gold (42), #fef6eb cream (11),
# #282828 body text (20). Dark mode deepens the sage rather than going neutral,
# so the identity survives the theme switch.
# auto, so the dark values above are actually used: light and dark emit one
# palette each, and only auto honours the reader's own setting.
main: kit: doc: style: mode: 'auto'

main: kit: doc: style: color: {
  primary: '#6ca3a4'
  accent: '#f4c24d'
  background: '#fef6eb'
  text: '#282828'
  darkBackground: '#14201f'
  darkText: '#f0e7d8'
}

# Published package names, declared so a change in the generator's naming
# rule cannot rename a released package.
main: kit: target: ts: publish: registry: package: '@voxgig-sdk/brontie-sdk'
main: kit: target: py: publish: registry: package: 'voxgig-sdk-brontie-sdk'
main: kit: target: rb: publish: registry: package: 'voxgig-sdk-brontie-sdk'
main: kit: target: lua: publish: registry: package: 'voxgig-sdk-brontie-sdk'
main: kit: target: php: publish: registry: package: 'voxgig-sdk/brontie-sdk'

# The npm release. 0.0.1 was published by hand, as a new package's first
# version must be; later versions are released by the publish-ts workflow.
main: kit: target: ts: publish: version: '0.0.2'

# A voucher is identified by the voucherToken its create response carries.
# apidef takes the voucher's fields from the create request, which has none,
# and names every entity's identity `id`, so the identity and its field are
# declared here.
main: kit: entity: voucher: {
  id: { field: 'voucherToken', name: 'voucherToken' }
  fields: voucherToken: {
    n: 'voucherToken'
    h: 'Voucher Token'
    r: false
    ro: true
    t: '`$STRING`'
    sh: 'Opaque voucher identifier.'
  }
}

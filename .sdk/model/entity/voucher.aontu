# Entity: voucher

main: kit: entity: voucher: {

  alias: field: {}

  fields: {
    amount: {
      h: "Amount"
      n: "amount"
      r: true
      sh: "Amount in EUR debited from the balance."
      t: "`$NUMBER`"
    }
    balanceAfter: {
      h: "Balance After"
      n: "balanceAfter"
      r: true
      sh: "On a 201, the balance after this debit."
      t: "`$NUMBER`"
    }
    expiresAt: {
      fo: "date-time"
      h: "Expires At"
      n: "expiresAt"
      r: true
      sh: "Five years from issue."
      t: "`$STRING`"
    }
    idempotencyKey: {
      h: "Idempotency Key"
      n: "idempotencyKey"
      r: true
      sh: "Unique per gift on the partner side, scoped per partner and per mode."
      t: "`$STRING`"
    }
    idempotentReplay: {
      h: "Idempotent Replay"
      n: "idempotentReplay"
      r: true
      t: "`$BOOLEAN`"
    }
    message: {
      h: "Message"
      n: "message"
      r: false
      sh: "Short personal note shown with the gift."
      t: "`$STRING`"
    }
    mode: {
      h: "Mode"
      n: "mode"
      r: true
      sh: "Derived from the API key prefix."
      t: "`$STRING`"
    }
    product: {
      h: "Product"
      n: "product"
      r: true
      sh: "`coffee` is EUR 5.00, `coffee_and_cake` is EUR 10.00."
      t: "`$STRING`"
    }
    recipient: {
      h: "Recipient"
      n: "recipient"
      r: false
      t: "`$OBJECT`"
    }
    redeemLink: {
      fo: "uri"
      h: "Redeem Link"
      n: "redeemLink"
      r: true
      sh: "The only field you need to keep."
      t: "`$STRING`"
    }
    reference: {
      h: "Reference"
      n: "reference"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "Always present."
      t: "`$STRING`"
    }
    senderName: {
      h: "Sender Name"
      n: "senderName"
      r: false
      sh: "Who the gift appears to be from, per call, so it can vary by course or cohort."
      t: "`$STRING`"
    }
    voucherToken: {
      h: "Voucher Token"
      n: "voucherToken"
      r: true
      sh: "Opaque voucher identifier."
      t: "`$STRING`"
    }
  }

  name: "voucher"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "idempotencyKey"
            "message"
            "product"
            "recipient"
            "reference"
            "senderName"
          ]
          co: {
            id: "POST /api/v1/vouchers"
            source: "openapi3"
            version: 2
          }
          li: {
            auth: "account"
            excluded: "Issues a permanent voucher; no delete or refund path exists"
            id: "voucher-create"
          }
          m: "POST"
          o: "/api/v1/vouchers"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "vouchers"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}

From 663f1e6bd5e3c2a46836c3f2a24bda1bf830d71d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 25 Sep 2026 21:14:12 +0000
Subject: [PATCH] Regenerate publish-ts.yml with sdkgen 4.30.0

The workflow names the package it publishes, @voxgig-sdk/brontie-sdk,
where it named @voxgig-sdk/brontie. That name is what the "already on
npm?" check asks the registry about, so a re-run after a successful
publish now skips instead of failing on a version conflict. The header
names the real repository, and .sdk/admin/setup-npm-trust.sh, which
registers this workflow with npm.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01MGpR2XhxWcDCB2n678tzAR
---
 .github/workflows/publish-ts.yml | 13 ++++++++-----
 1 file changed, 8 insertions(+), 5 deletions(-)

diff --git a/.github/workflows/publish-ts.yml b/.github/workflows/publish-ts.yml
index c834127..3933837 100644
--- a/.github/workflows/publish-ts.yml
+++ b/.github/workflows/publish-ts.yml
@@ -1,17 +1,20 @@
 # Generated by @voxgig/sdkgen. Do not edit.
 #
-# Publishes @voxgig-sdk/brontie (the `ts/` target) to npm, via GitHub OIDC Trusted
+# Publishes @voxgig-sdk/brontie-sdk (the `ts/` target) to npm, via GitHub OIDC Trusted
 # Publishing — no NPM_TOKEN. npm exchanges a short-lived OIDC token minted
 # for THIS job in THIS repository for a publish credential, and attaches SLSA
 # provenance automatically.
 #
 # SET UP ONCE, by a maintainer with publish rights — see .sdk/PUBLISHING.md:
 #
-#   npm trust github @voxgig-sdk/brontie \
-#     --repository <owner>/<repo> \
+#   npm trust github @voxgig-sdk/brontie-sdk \
+#     --repository voxgig-sdk/brontie-sdk \
 #     --file publish-ts.yml \
 #     --allow-publish
 #
+# .sdk/admin/setup-npm-trust.sh registers exactly this, and with --check
+# reports any drift from it.
+#
 # THE FILENAME IS PART OF THAT CONFIGURATION. Renaming this file breaks
 # publishing until the npm side is updated to match.
 #
@@ -94,7 +97,7 @@ jobs:
           VERSION="$(node -p "require('./package.json').version")"
           test -n "$VERSION" || { echo "::error::no version in ts/package.json"; exit 1; }
           echo "version=$VERSION" >> "$GITHUB_OUTPUT"
-          echo "@voxgig-sdk/brontie $VERSION"
+          echo "@voxgig-sdk/brontie-sdk $VERSION"
 
       - run: npm install
         working-directory: ts
@@ -139,7 +142,7 @@ jobs:
           VERSION: ${{ needs.verify.outputs.version }}
         run: |
           set -euo pipefail
-          if npm view "@voxgig-sdk/brontie@$VERSION" version >/dev/null 2>&1; then
+          if npm view "@voxgig-sdk/brontie-sdk@$VERSION" version >/dev/null 2>&1; then
             echo "published=true" >> "$GITHUB_OUTPUT"
             echo "$VERSION is already on npm — skipping publish"
           else
